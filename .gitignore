# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# Data (raw/processed data is regenerated via scripts, not committed)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Large outputs (keep small sample outputs used by Power BI docs, ignore bulk)
outputs/*.parquet

# Power BI local cache files
powerbi/*.pbix.bak
*.pbix.tmp

# Power BI Project (.pbip) local-only artifacts — the model/report definition
# (TMDL, .pbir, .pbism, JSON) is source and gets committed; everything under
# .pbi/ (cache, editor state, local settings) is machine-local and
# regenerated on open, not part of the model.
**/.pbi/
*.abf

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
